lertArguments\", \"type\": \"object\"}, \"name\": \"get_alert\"}, {\"description\": \"Trades for one venue and product in [start, end) (ISO-8601, at most 30 minutes):\\n        summary statistics (count, volume, notional, VWAP, OHLC, price range in bps, buy share,\\n        REST-backfilled count) and up to `limit` (max 500) trades in time order.\", \"input_schema\": {\"properties\": {\"end\": {\"title\": \"End\", \"type\": \"string\"}, \"limit\": {\"default\": 200, \"title\": \"Limit\", \"type\": \"integer\"}, \"product_id\": {\"enum\": [\"BTC-USD\", \"ETH-USD\", \"SOL-USD\"], \"title\": \"Product Id\", \"type\": \"string\"}, \"start\": {\"title\": \"Start\", \"type\": \"string\"}, \"stream\": {\"default\": \"live\", \"enum\": [\"live\", \"inj\"], \"title\": \"Stream\", \"type\": \"string\"}, \"venue\": {\"enum\": [\"coinbase\", \"kraken\"], \"title\": \"Venue\", \"type\": \"string\"}}, \"required\": [\"venue\", \"product_id\", \"start\", \"end\"], \"title\": \"query_tradesArguments\", \"type\": \"object\"}, \"name\": \"query_trades\"}, {\"description\": \"The detector's most recent alerts for this product before a timestamp (up to k, max 20)\\n        and its 24-hour base rate (count, median and p95 score) for context on how unusual this is.\", \"input_schema\": {\"properties\": {\"before\": {\"title\": \"Before\", \"type\": \"string\"}, \"detector\": {\"enum\": [\"volume_spike\", \"spoof_layering\", \"dislocation\", \"wash_trade\"], \"title\": \"Detector\", \"type\": \"string\"}, \"k\": {\"default\": 10, \"title\": \"K\", \"type\": \"integer\"}, \"product_id\": {\"enum\": [\"BTC-USD\", \"ETH-USD\", \"SOL-USD\"], \"title\": \"Product Id\", \"type\": \"string\"}, \"stream\": {\"default\": \"live\", \"enum\": [\"live\", \"inj\"], \"title\": \"Stream\", \"type\": \"string\"}}, \"required\": [\"detector\", \"product_id\", \"before\"], \"title\": \"similar_past_alertsArguments\", \"type\": \"object\"}, \"name\": \"similar_past_alerts\"}]", "cross_venue_context {\"bucket